                  raw_loc: "1201..1480",
                  start: "Ln 47, Col 1",
                  end: "Ln 56, Col 4",
                  src: "class CircleQuadrant extends Quadrant is\n    this(xMul: Real, yMul: Real) is\n        this.xMul := xMul\n        this.yMul := yMul\n    end\n\n    method CalcHit(x: Real, y: Real, r: Real): Boolean is\n        return x.Mult(x).Plus(y.Mult(y)).LessOrEqual(Rx(r).Mult(Rx(r)))\n    end\nend",
