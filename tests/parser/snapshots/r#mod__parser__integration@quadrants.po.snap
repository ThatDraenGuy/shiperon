                  raw_loc: "922..1199",
                  start: "Ln 36, Col 1",
                  end: "Ln 45, Col 4",
                  src: "class RectQuadrant extends Quadrant is\n    this(xMul: Real, yMul: Real) is\n        this.xMul := xMul\n        this.yMul := yMul\n    end\n\n    method CalcHit(x: Real, y: Real, r: Real): Boolean is\n        return Abs(x).LessOrEqual(Rx(r)).And(Abs(y).LessOrEqual(Ry(r)))\n    end\nend",
