      raw_loc: "000..543",
      start: "Ln 1, Col 1",
      end: "Ln 25, Col 4",
      src: "class Program is\n    method MaxInt(a: IntArray) : Integer\n\n    this() is\n        var arr : IntArray(5)\n        arr.set(0, 0)\n        arr.set(1, 1)\n        arr.set(2, 2)\n        arr.set(3, 3)\n        arr.set(4, 4)\n        return MaxInt(arr)\n    end\n\n    method MaxInt(a: IntArray) : Integer is\n        var max : Integer.Min\n        var i : Integer(1)\n        while i.Less(a.Length) loop\n            if a.get(i).Greater(max) then\n                max := get(i)\n            end\n            i := i.Plus(1)\n        end\n        return max\n    end\nend",
      data: (
          classes: [
