class Shape is
    this() is
    end
    method area(): Real => 0.0
end

class Square extends Shape is
    var side: Real(0.0)

    this(side: Real) is
        this.side := side // differentiating between variables with same name
    end

    method area(): Real => side.Mult(side) // object passed into its own method
end

class Rectangle extends Shape is
    var a: Real(0.0)
    var b: Real(0.0)

    this(a: Real, b: Real) is
        this.a := a
        this.b := b
    end

    method area(): Real => a.Mult(b)
end

class Math is
    this() is
    end
    var PI: 3.1415
end

class Circle extends Shape is
    var r: Real(0.0)

    this(r: Real) is
        this.r := r
    end

    method area(): Real => Math().PI.Mult(r).Mult(r)
end

class Main is
    var result: 0.0
    this(args: Array) is
        if args.Length().Equal(3) then
            var typeStr: args.Get(0) as String
            var aStr: args.Get(1) as String
            var bStr: args.Get(2) as String
            if aStr.IsReal().And(bStr.IsReal()) then
                var a: aStr.ToReal()
                var b: bStr.ToReal()

                var shape : Shape()
                if typeStr.Equal("Square") then
                    shape := Square(a)
                end
                if typeStr.Equal("Rect") then
                    shape := Rectangle(a, b)
                end
                if typeStr.Equal("Circle") then
                    shape := Circle(a)
                end
                result := shape.area()
            end
        end
    end

    method ToString(): String => result.ToString()
end
