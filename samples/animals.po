class Animal is
    this() is
    end
    method Speak(): String => String()
end

class Dog extends Animal is
    this() is
    end
    method Speak(): String => "Woof"
end

class Cat extends Animal is
    this() is
    end
    method Speak(): String => "Meow"
end

class Main is
    var result: String()

    this(args: Array) is
        if args.Length().Equal(1).Not() then
            result := "Expected a single animal-name argument"
        else
            var name: args.Get(0) as String

            var animal: Animal()
            if name.Equal("Dog") then
                animal := Dog()
            else
                if name.Equal("Cat") then
                    animal := Cat()
                else
                    result := "Invalid animal name. Valid names: Dog, Cat"
                end
            end
            if result.Equal("") then
                result := animal.Speak()
            end
        end
    end

    method ToString(): String => result
end